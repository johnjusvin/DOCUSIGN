# ============================= REDITUS SIGN — Environment =============================
# Copy to .env and adjust. Nothing here is committed to Git.

# --- General ---
# Port and host the app listens on (localhost by default).
PORT=4000
HOST=127.0.0.1
# Public URL of the app; used to build signer links. Defaults to http://localhost:PORT.
REDITUS_APP_URL=

# --- Dashboard auth (protects the REDITUS dashboard) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- Data ---
# Directory for the SQLite metadata DB and the local-disk storage fallback.
REDITUS_DATA_DIR=./data

# --- Storage ---
# storsge = "drive" (Google Drive) | "local" (local disk fallback).
# Defaults to "drive" when Google credentials are present, otherwise "local".
STORAGE=drive

# --- Google Drive (only external storage layer) ---
# OAuth 2.0 Web application client (Google Cloud Console -> Credentials).
# Add this exact redirect URI in the Google Cloud Console:
#   http://localhost:4000/api/storage/drive/oauth/callback
# (replace host/port to match REDITUS_APP_URL when deployed elsewhere)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Optional: root Drive folder id to host the REDITUS SIGN tree. When empty a
# folder named "REDITUS SIGN" is created at the Drive root on first auth.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Optional: when set and true, skip remote file downloads entirely (testing only).
GOOGLE_DRIVE_OFFLINE_MODE=

# --- Security tuning (optional) ---
# Signer link lifetime in hours (default 0 = never expires).
SIGNING_LINK_EXPIRY_HOURS=0
# Max uploaded PDF size in bytes (default 25 MB).
MAX_UPLOAD_BYTES=26214400
# Max signature image size in bytes (default 5 MB).
MAX_SIGIMAGE_BYTES=5242880